DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60

DJANGO_MEDIA_ROOT=
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO
